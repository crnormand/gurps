{{#*inline ".entry"}}
<tr class="move-entry" data-uuid="{{uuid}}">
  <td>
    <div class="form-fields">
    {{formInput schema.fields.mode
      name=(concat fieldPath "." _id ".mode")
      value=_source.mode
    }}
    </div>
  </td>
  <td>
    <div class="form-fields">
    {{formInput schema.fields.basic
      name=(concat fieldPath "." _id ".basic")
      value=_source.basic
    }}
    </div>
  </td>
  <td>
    <div class="form-fields">
    {{formInput schema.fields.enhanced
      name=(concat fieldPath "." _id ".enhanced")
      value=_source.enhanced
    }}
    </div>
  </td>
  <td>
    <button
      type="button"
      data-action="deleteEmbedded"
    >
      <i class="fa-solid fa-trash"></i>
    </button>
  </td>
</tr>
{{/inline}}

<section class='{{cssClass}}'>
  <table class="gcs-table gcs-move-mode-table">
    <thead>
      <tr>
        <th>{{localize "GURPS.moveModeType"}}</th>
        <th>{{localize "GURPS.basic"}}</th>
        <th>{{localize "GURPS.enhanced"}}</th>
        <th><button type="button" data-action="createEmbedded" data-document-name="MoveMode"><i class="fa-solid fa-plus"></i></button></th>
      </tr>
    </thead>
    </tbody>
    {{#each moveModes}}
      {{> ".entry"}}
    {{else}}
      <div>{{localize 'GURPS.none'}}</div>
    {{/each}}
    </tbody>
  </table>
</section>
