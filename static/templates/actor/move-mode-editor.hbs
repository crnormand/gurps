{{#*inline ".entry"}}
<tr class="move-entry" data-uuid="{{move.uuid}}" data-move-id="{{move._id}}">
  <td>
    <div class="form-fields move-mode-fields">
      <select data-move-mode aria-label="{{localize 'GURPS.moveModeEditor.mode'}}">
        {{selectOptions @root.modeChoices selected=selectedMode localize=true}}
        <option value="" {{#if isCustom}}selected{{/if}}>{{localize 'GURPS.moveModeEditor.custom'}}</option>
      </select>
      <input type="text" data-move-mode-name
        name="{{move.fieldPath}}.{{move._id}}.mode"
        value="{{modeValue}}"
        aria-label="{{localize 'GURPS.moveModeEditor.customName'}}"
        {{#unless isCustom}}hidden{{/unless}}
      />
    </div>
  </td>
  <td>
    <div class="form-fields">
    {{formInput move.schema.fields.basic
      name=(concat move.fieldPath "." move._id ".basic")
      value=move._source.basic
    }}
    </div>
  </td>
  <td>
    <div class="form-fields">
    {{formInput move.schema.fields.enhanced
      name=(concat move.fieldPath "." move._id ".enhanced")
      value=move._source.enhanced
    }}
    </div>
  </td>
  <td>
    <button
      type="button"
      data-action="deleteEmbedded"
    >
      <i class="fa-solid fa-trash"></i>
    </button>
  </td>
</tr>
{{/inline}}

<section class='{{cssClass}}'>
  <table class="gcs-table gcs-move-mode-table">
    <thead>
      <tr>
        <th>{{localize "GURPS.moveModeEditor.mode"}}</th>
        <th>{{localize "GURPS.moveModeEditor.basic"}}</th>
        <th>{{localize "GURPS.moveModeEditor.enhanced"}}</th>
        <th><button type="button" data-action="createEmbedded" data-document-name="MoveMode"><i class="fa-solid fa-plus"></i></button></th>
      </tr>
    </thead>
    <tbody>
    {{#each moveModes}}
      {{> ".entry"}}
    {{else}}
      <div>{{localize 'GURPS.none'}}</div>
    {{/each}}
    </tbody>
  </table>
</section>
