{{#*inline ".noteEntry"}}
  <tr class="gcs-action-row"
      data-uuid="{{uuid}}"
      data-has-children="{{hasChildren}}"
      draggable="true">
    <td class="gcs-item-name-cell">
      <div class="gcs-item-name-line indent{{indent}}">
        {{#if hasChildren}}
        <i
          class="fa-solid fa-caret-down gcs-container-toggle"
          data-open="{{childrenOpen}}"
          data-action="toggleContainer"
        ></i>
        {{else}}
        <span class="gcs-container-spacer"></span>
        {{/if}}

        <span class="gcs-item-name-text">
            {{#unless isEmpty}}
                {{#if fullName}}<strong>{{{gurpslinkbr fullName}}}</strong> {{/if}}{{{gurpslinkbr notes}}}
            {{else}}
                {{localize "GURPS.noteBlank"}}<i class='far fa-laugh-wink'></i>            
            {{/unless}}
        </span>
      </div>
    </td>
  </tr>
  {{#if (and hasChildren childrenOpen)}}
  {{#each children}}
    {{> ".noteEntry"}}
  {{/each}}
  {{/if}}
{{/inline}}

<div class="gcs-item-table-container">
<table data-table-id="notes" class="gcs-table gcs-item-table gcs-note-table ">
  <colgroup>
    <col class="gcs-col-name">
  </colgroup>
  <thead>
    <tr>
      <th class="gcs-sortable" data-action="sortItems" data-sort-by="{{sortKeys.notes.name}}">
        {{localize "GURPS.sheet.gcsActorSheet.notes"}}
        <a type="button" data-action="createEmbedded" data-document-name="Note">
            <i class="fa-solid fa-plus"></i>
        </a>
      </th>
    </tr>
  </thead>
  <tbody>
    {{#each notes}}
      {{> ".noteEntry"}}
    {{else}}
    <tr class="gcs-item-empty">
      <td >{{localize "GURPS.none"}}</td>
    </tr>
    {{/each}}
  </tbody>
</table>
</div>
