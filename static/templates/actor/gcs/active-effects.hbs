<div class="gcs-active-effects gcs-section">
  <div class="gcs-section-header">
    <span class="gcs-title">{{localize "GURPS.activeEffects"}}</span>
    <a data-action="addEffect" title="{{localize 'GURPS.effectPicker.title'}}">
      <i class="fa-solid fa-plus"></i>
    </a>
  </div>
  <div class="gcs-section-content gcs-active-effects-content">
    {{#each effects}}
      <span class="gcs-effect-tag {{ifThen this.disabled 'gcs-effect-disabled' ''}}" data-effect-id="{{this.id}}" data-uuid="{{this.uuid}}" title="{{this.name}}">
        {{#if this.img}}<img src="{{this.img}}" class="gcs-effect-icon" />{{/if}}
        <span class="gcs-effect-name" data-action="editEffect" data-effect-id="{{this.id}}" data-uuid="{{this.uuid}}">{{this.name}}</span>
        <a data-action="toggleEffect" data-effect-id="{{this.id}}" data-uuid="{{this.uuid}}" title="{{ifThen this.disabled (localize 'GURPS.enable') (localize 'GURPS.disable')}}">
          <i class="fa-solid {{ifThen this.disabled 'fa-toggle-off' 'fa-toggle-on'}}"></i>
        </a>
        <a data-action="deleteEffect" data-effect-id="{{this.id}}" data-uuid="{{this.uuid}}" title="{{localize 'GURPS.delete'}}">
          <i class="fa-solid fa-trash"></i>
        </a>
      </span>
    {{else}}
      <span class="gcs-no-effects">{{localize "GURPS.none"}}</span>
    {{/each}}
  </div>
</div>
