<div class='cr-container'>
  <div class='cr-current-modifiers-section'>
    <div class='cr-section-header'>{{localize "GURPS.modifierCurrentModifiers"}}</div>
    <div class='cr-section-subheader'>({{localize "GURPS.clickToRemove"}})</div>
    <div class='cr-current-modifiers-list'>
      {{#each currentModifiers}}
        <div class="removemod {{#if this.plus}}plus{{else}}minus{{/if}}" data-index="{{@index}}" data-action="removeMod">
          {{this.mod}} : {{this.desc}}
        </div>
      {{/each}}
    </div>
    <div class='modttlabel'>Total:&nbsp;
      <div {{#if (gt totalMods 0)}}class='plus' {{/if}}{{#if (lt totalMods 0)}}class='minus'
        {{/if}}>
        {{totalMods}}
      </div>
    </div>
  </div> 
  <div class='cr-modifiers-section'>
    <div class='cr-section-header'>{{localize "GURPS.addModifiers"}}</div>
    {{#each modifierData}}
      <details{{#if this.open}} open{{/if}}>
        <summary class='cr-section-subheader'>{{this.title}}</summary>
        <div class='{{this.class}} cr-modifier-list'>
          {{#each this.modifiers}}
            {{{this}}}
          {{/each}}
        </div>
      </details>
    {{/each}}
  </div>    
</div> 