<div class='cr-dialog-body'>
  {{#if messages}}
    <div class='cr-messages'>
      {{#each messages}}
        <div class='cr-message'>
          <i class='fa-solid fa-triangle-exclamation'></i><span>{{this}}</span>
        </div>
      {{/each}}
    </div>
  {{/if}}
  <div class='cr-container'>
    <div class='cr-modifiers-section'>
      <div class='cr-section-header'>{{localize "Add Modifiers"}}</div>
      <div class='cr-section-subheader'>{{localize "GURPS.hitLocations"}}</div>
      <div class='cr-hitLocations'>
        {{#each hitLocations}}
          {{{this}}}
        {{/each}}
      </div>
      <div class='cr-section-subheader'>{{localize "GURPS.modifierOthers"}}</div>
      <div class='cr-generic-modifiers'>
        {{#each genericModifiers}}
          {{{this}}}
        {{/each}}
      </div>
    </div>    
    <div class='cr-current-modifiers-section'>
      <div class='cr-section-header'>{{localize "GURPS.modifierCurrentModifiers"}}</div>
      <div class='shaded-group overflowy'>
        <aside>({{localize "GURPS.clickToRemove"}})</aside>
        {{#each currentModifiers}}
          <div class="removemod {{#if this.plus}}plus{{else}}minus{{/if}}" data-index="{{@index}}" data-action="removeMod">
            {{this.mod}} : {{this.desc}}
          </div>
        {{/each}}
      </div>
      <div class='modttlabel'>Total:&nbsp;
        <div {{#if (gt totalMods 0)}}class='plus' {{/if}}{{#if (lt totalMods 0)}}class='minus'
          {{/if}}>
          {{totalMods}}
        </div>
      </div>
    </div>    
    <div class='cr-token-section'>
      {{#if isVideo}}
        <video class='cr-token-img' src='{{tokenImage}}' autoplay loop muted></video>
      {{else}}
        <img class='cr-token-img' src='{{tokenImage}}' alt='' />
      {{/if}}
      <div class='cr-token-name'>{{tokenName}}</div>
    </div>
    <div class='cr-result-section'>
      <div class='cr-result-math'>
        <span id='cr-target'>{{target}}</span>
        <span id='cr-operator'>{{operator}}</span>
        <span id='cr-totalmods'>{{totalMods}}</span>
      </div>
      <div id='cr-total' class='cr-result-total' style='color: {{targetColor}};'>{{totalRoll}}</div>
      <span class='cr-tooltip'>{{rollChance}}</span>
      <div class='cr-result-type'>{{rollType}}</div>
    </div>
    <div class='cr-item-section'>
      <div class='cr-item-img-container'>
        {{#if itemImage}}
          <img class='cr-item-img' src='{{itemImage}}' alt='' />
        {{else}}
          <div class='cr-item-icon' style='background-color: {{itemColor}};'><i class='{{itemIcon}}'></i></div>
        {{/if}}
        {{#if consumeActionIcon}}
          <div
            class='consume-action-badge'
            style='background-color: {{consumeActionColor}}'
            title='{{consumeActionLabel}}'
          >{{{consumeActionIcon}}}</div>
        {{/if}}
      </div>
      <div class='cr-item-roll'>{{targetRoll}}</div>
    </div>
  </div>
</div>